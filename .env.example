# =====================================================================
# TrainingBench environment configuration template
# =====================================================================
#
# Copy this file to .env in the project root, then uncomment and edit
# the values you want to override. Anything you leave commented uses
# the default baked into the code. The .env file itself is gitignored
# so your local secrets do not get committed.
#
# Variables marked CHANGE_ME below are unsafe to leave at their
# defaults for any deployment that other people can reach. Anything
# else is a tuning knob you can leave alone for a first install.
#
# Most paths below default to locations under the project directory,
# so multiple TrainingBench installs on the same machine do not
# collide. If you change one path, the others usually do not need to
# move with it.


# ---------------------------------------------------------------------
# Server & network
# ---------------------------------------------------------------------

# Port the backend listens on. Used by your uvicorn command line and
# by the systemd service template. The code itself reads --port from
# uvicorn, so this is really a convenience variable for your shell.
# APP_PORT=8000

# CORS allow list. Comma-separated origins, or * for any origin.
# ALLOWED_ORIGINS=*


# ---------------------------------------------------------------------
# Authentication (login)
# ---------------------------------------------------------------------

# Whether to require login at all. true for normal use, false for
# a fully-open read-only instance (rarely what you want).
# WEB_AUTH_ENABLED=true

# Random secret used to sign session cookies. CHANGE THIS for any
# real deployment. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=CHANGE_ME_TO_A_RANDOM_32_BYTE_URL_SAFE_STRING


# ---------------------------------------------------------------------
# Initial admin user (created on first server boot if no users exist)
# ---------------------------------------------------------------------

# Used only the first time the server starts and discovers an empty
# users table. After the first boot, change the password and email
# by API or by editing users.db directly.
#
# DEFAULT_ADMIN_EMAIL must be set by you for each install. The default
# below is a placeholder; it is not your address and does not route
# anywhere useful. Replace it with the address you actually want to
# receive admin-related correspondence at for this install.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=CHANGE_ME
# DEFAULT_ADMIN_EMAIL=CHANGE_ME@example.com


# ---------------------------------------------------------------------
# Password hashing
# ---------------------------------------------------------------------

# Salt used when hashing passwords. Setting this to a value unique
# to your deployment is the minimum bar; per-user random salts are
# a future improvement (see TB-US-003 in the backlog).
# PASSWORD_SALT=CHANGE_ME_TO_A_RANDOM_STRING_UNIQUE_TO_THIS_DEPLOYMENT


# ---------------------------------------------------------------------
# Site-access passphrase gate (optional)
# ---------------------------------------------------------------------

# If set, the server requires visitors to enter this passphrase
# before they can reach the login page. Useful for sharing a demo
# without exposing it fully. Leave unset to disable the gate.
# SITE_PASSPHRASE=


# ---------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------

# Seeds app_settings.json on first boot. Once seeded, runtime
# changes go through the in-app toggle, not this variable. Set to
# "true" to start in demo mode; "false" otherwise.
# DEMO_MODE=false


# ---------------------------------------------------------------------
# LLM provider selection (the RAG generation backend)
# ---------------------------------------------------------------------

# Which model serves the RAG generation step. Supported values:
#   peft   - a locally-loaded PEFT adapter (you trained it yourself)
#   ollama - a model served by a local Ollama daemon
#   openai - the OpenAI API (requires OPENAI_API_KEY)
# LLM_PROVIDER=peft

# Optional explicit model identifier passed to the chosen provider.
# If unset, the provider falls back to its own default (see below).
# LLM_MODEL=


# ---------------------------------------------------------------------
# PEFT-specific (when LLM_PROVIDER=peft)
# ---------------------------------------------------------------------

# Path to the PEFT adapter the RAG uses. The placeholder default
# points at a directory that does not exist by default — you build
# this directory by training an adapter (see TB-US-001).
# PEFT_ADAPTER_PATH=training/adapters/example


# ---------------------------------------------------------------------
# Ollama-specific (when LLM_PROVIDER=ollama)
# ---------------------------------------------------------------------

# Model tag to request from the Ollama daemon. Make sure you have
# pulled this model first: `ollama pull llama3.1:8b`.
# OLLAMA_MODEL=llama3.1:8b

# URL of the Ollama HTTP API. Default is the standard local install.
# OLLAMA_BASE_URL=http://localhost:11434


# ---------------------------------------------------------------------
# OpenAI-specific (when LLM_PROVIDER=openai)
# ---------------------------------------------------------------------

# Set OPENAI_API_KEY in this file or your shell when using the
# openai provider. There is no default — calls will fail without it.
# OPENAI_API_KEY=sk-...

# OPENAI_MODEL=gpt-3.5-turbo


# ---------------------------------------------------------------------
# Generation tuning (applies to whichever provider you picked)
# ---------------------------------------------------------------------

# Sampling temperature. Higher = more varied output.
# LLM_TEMPERATURE=0.7

# Nucleus (top-p) sampling cutoff.
# LLM_TOP_P=0.9

# Top-k sampling cutoff (PEFT/HuggingFace path only).
# LLM_TOP_K=40

# Maximum new tokens per generation (PEFT/HuggingFace path only).
# LLM_MAX_NEW_TOKENS=512


# ---------------------------------------------------------------------
# Document chunking for ingestion
# ---------------------------------------------------------------------

# Approximate token chunk size when splitting documents for the
# vector store. Larger chunks preserve more context per match but
# pay more retrieval cost.
# RAG_CHUNK_SIZE=1000

# Overlap between adjacent chunks, in tokens.
# RAG_CHUNK_OVERLAP=200


# ---------------------------------------------------------------------
# Vector store (ChromaDB)
# ---------------------------------------------------------------------

# Logical collection name within the ChromaDB instance.
# CHROMA_COLLECTION_NAME=documents

# Where ChromaDB persists its files. Defaults to a directory in the
# project root.
# CHROMA_PERSIST_DIRECTORY=./chroma_db

# Batch size for adds. ChromaDB has an internal limit around 5,461
# entries per add(); the default keeps a comfortable margin.
# CHROMA_ADD_BATCH=5000


# ---------------------------------------------------------------------
# Web scraper
# ---------------------------------------------------------------------

# Maximum pages followed during a single crawl.
# SCRAPER_MAX_PAGES=50

# Sleep between requests within a single crawl, in seconds.
# SCRAPER_REQUEST_DELAY_SECONDS=1.0

# Per-request HTTP timeout in seconds.
# SCRAPER_REQUEST_TIMEOUT_SECONDS=30

# Threshold below which the scraper assumes a PDF is scanned and
# falls back to OCR rather than text extraction. Measured in
# characters of text returned by pypdf.
# OCR_FALLBACK_MIN_CHARS=100


# ---------------------------------------------------------------------
# Persistent runtime data paths
# ---------------------------------------------------------------------

# Where the SQLite user database lives.
# USERS_DB_PATH=users.db

# Where the SQLite session log lives.
# SESSIONS_DB_PATH=sessions.db

# How many days of session records to keep before cleanup_old_sessions
# is allowed to delete them.
# SESSION_RETENTION_DAYS=90

# Where AppSettings persists toggleable runtime config.
# APP_SETTINGS_PATH=app_settings.json

# Where audit lines are appended when demo mode is toggled.
# DEMO_MODE_AUDIT_LOG_PATH=logs/demo_mode_audit.jsonl

# Where the database-manager config lives. This file lists the
# available RAG databases the user can switch between in the UI.
# DATABASE_CONFIG_FILE=database_config.json


# ---------------------------------------------------------------------
# Training pipeline paths
# ---------------------------------------------------------------------

# Where the training-set metadata DB lives.
# TRAINING_REGISTRY_DB_PATH=training/datasets/registry.db

# Root directory under which training datasets live on disk.
# TRAINING_BASE_DIR=training/datasets


# ---------------------------------------------------------------------
# End of template
# ---------------------------------------------------------------------
